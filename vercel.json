{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/psicologia",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/psicologia/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/psicologia/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/fisioterapia",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/fisioterapia/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/fisioterapia/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/nutricao",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/nutricao/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/nutricao/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/demos/:demo(maillard|eridan)/assets/:file*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/demos/:demo(maillard|eridan)/:pasta(media|fonts)/:file*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
